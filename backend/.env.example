SUPABASE_URL=https://mmshnhvvxujzbkehooqo.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_me
SUPABASE_SECRET_KEY=replace_me
SUPABASE_JWT_SECRET=
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# ENCRYPTION_KEY must be a URL-safe Base64-encoded 32-byte (256-bit) key.
# Generate with: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# WARNING: Losing or rotating this key without a migration plan makes encrypted data unrecoverable.
# Store the key in a managed secret store (KMS, Vault, etc.) in production. Never commit it.
ENCRYPTION_KEY=replace_with_32_byte_urlsafe_base64_key
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_REQUIRED_FOR_PRIVATE_ENDPOINTS=true

# Integration stub persistence & admin access (development / demo mode)
# STUB_STATE_PATH enables durable AES-256-GCM encrypted persistence across restarts when ENCRYPTION_KEY is configured.
# If omitted in development with ENCRYPTION_KEY set, defaults to .stub_state.json in the backend directory.
STUB_STATE_PATH=.stub_state.json
STUB_ADMIN_KEY=adm

