# INCOGNITO HR Dashboard Configuration (Client-side non-secret variables only)
# Backend API Base URL (FastAPI)
VITE_API_BASE_URL=http://localhost:8000

# Fallback to high-fidelity in-browser security engine when backend is offline
VITE_USE_MOCK_FALLBACK=true

# Optional stub admin key for authenticated dev endpoints
VITE_STUB_ADMIN_KEY=adm

# Blockchain Network Name
VITE_BLOCKCHAIN_NETWORK=polygon-pos-mainnet
