# INCOGNITO HR Dashboard Configuration (Client-side non-secret variables only)
# Backend API Base URL (FastAPI)
VITE_API_BASE_URL=http://localhost:8000

# Live data only. Set to true to fall back to the in-browser demo data when the backend is unreachable
VITE_USE_MOCK_FALLBACK=false

# Must match the backend's STUB_ADMIN_KEY
VITE_STUB_ADMIN_KEY=adm

# Blockchain Network Name
VITE_BLOCKCHAIN_NETWORK=polygon-amoy
