# Blockchain / ZK (Member 4). Copy to .env and fill in. Never commit .env.
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
RELAYER_PRIVATE_KEY=0x<64 hex>
RELAYER_ADDRESS=0x<address>
SEMAPHORE_ADDRESS=0x8A1fd199516489B0Fb7153EB5f075cDAC83c693D
SEMAPHORE_GROUP_ID=23
REGISTRY_ADDRESS=0x20DeEc5fb1Ba77fe8e9c67a5C8822b17c094bD1e
DATABASE_URL=postgresql://postgres:<pw>@db.<project>.supabase.co:5432/postgres
EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/{hash}
MIN_PRIORITY_GWEI=30
ANCHOR_INTERVAL_S=5
ZK_SIGNAL_MODE=text

# Integration stub persistence & admin access (development / demo mode)
# STUB_STATE_PATH enables durable AES-256-GCM encrypted persistence across restarts when ENCRYPTION_KEY is configured.
STUB_STATE_PATH=backend/.stub_state.json
STUB_ADMIN_KEY=adm

